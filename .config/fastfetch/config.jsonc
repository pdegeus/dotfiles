{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "key": {
            "width": 15
        },
        "bar": {
            "char": {
                "elapsed": "=",
                "total": "-"
            },
            "width": 13
        },
        "percent": {
            "type": 2
        }
    },
  "modules": [
    "title",
    "separator",
    "datetime",
    "os",
    "uptime",
    "break",
    "memory",
    "swap",
    "disk"
  ]
}
